if(NOT IS_DIRECTORY "${SOURCE}" OR NOT DEFINED DESTINATION)
    message(FATAL_ERROR "CopyProject needs SOURCE and DESTINATION")
endif()
file(GLOB_RECURSE project_files LIST_DIRECTORIES FALSE RELATIVE "${SOURCE}" "${SOURCE}/*")
foreach(relative IN LISTS project_files)
    if(relative MATCHES "(^|/)(\\.twodog|\\.vs|bin|obj)(/|$)")
        continue()
    endif()
    get_filename_component(parent "${DESTINATION}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    configure_file("${SOURCE}/${relative}" "${DESTINATION}/${relative}" COPYONLY)
endforeach()
