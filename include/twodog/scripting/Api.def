// Single native contract. Stable opcodes; JSON fields are shared by every future language binding.
// TD_API(Name, opcode, request schema, result schema)
TD_API(Log, 1, "level:string,message:string", "null")
TD_API(Find, 2, "name:string", "string")
TD_API(Alive, 3, "entity:string", "bool")
TD_API(GetTransform, 4, "entity:string", "Transform{position:vec2,size:vec2,rotation:float}")
TD_API(SetTransform, 5, "entity:string,transform:Transform", "null")
TD_API(Create, 6, "entity:EntityDocument", "string")
TD_API(Destroy, 7, "entity:string", "null")
TD_API(Instantiate, 8, "prefab:string,position:vec2", "string")
TD_API(Input, 9, "action:string", "Action{down:bool,pressed:bool,released:bool}")
TD_API(Axis, 10, "axis:int", "float")
TD_API(Pointer, 11, "", "vec2")
TD_API(GetVelocity, 12, "entity:string", "vec2")
TD_API(SetVelocity, 13, "entity:string,value:vec2", "null")
TD_API(Impulse, 14, "entity:string,value:vec2", "null")
TD_API(Force, 15, "entity:string,value:vec2", "null")
TD_API(Raycast, 16, "origin:vec2,translation:vec2,ignore?:string", "Hit{entity:string,point:vec2,normal:vec2,fraction:float}|null")
TD_API(PlayAudio, 17, "asset:string,bus:string,loop:bool", "string")
TD_API(StopAudio, 18, "voice:string", "null")
TD_API(Volume, 19, "bus:string,value:float", "null")
TD_API(LoadScene, 20, "asset:string", "null")
TD_API(SaveScene, 21, "path:string", "null")
TD_API(GetComponent, 22, "entity:string,component:string", "object|null")
TD_API(SetComponent, 23, "entity:string,component:string,value:object", "null")
TD_API(Send, 24, "entity:string,topic:string,payload:JSON", "null")
TD_API(Camera, 25, "center?:vec2,zoom?:float,follow?:string,shake?:float,bounds?:vec4,smoothing?:float,pixelPerfect?:bool,pixelsPerUnit?:float", "null")
TD_API(Emit, 26, "position:vec2,count:int,color:vec4", "null")
TD_API(SetState, 27, "entity:string,state:string", "null")
TD_API(ListEntities, 28, "", "string[]")
TD_API(AddCollider, 29, "entity:string,collider:ColliderDocument", "null")
TD_API(CreateJoint, 30, "joint:JointDocument", "string")
TD_API(DestroyJoint, 31, "joint:string", "null")
TD_API(BatchRead, 32, "queries:Request[]", "JSON[]")
TD_API(BindAction, 33, "action:string,bindings:Binding[]", "null")
